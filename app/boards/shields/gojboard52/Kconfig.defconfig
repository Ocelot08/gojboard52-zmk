
if SHIELD_gojboard52_LEFT

config ZMK_KEYBOARD_NAME
    default "gojboard52"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Widgets needed by this shield's own custom_status_screen.c. These must
# stay off when nice_view is also in the build - it ships its own status
# screen that independently re-implements the same widgets under the same
# internal names, so having both on causes duplicate-symbol link errors.
if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM && !NICE_VIEW_WIDGET_STATUS && !NICE_VIEW_DUAL_STATUS

config ZMK_WIDGET_BATTERY_STATUS
    default y

config ZMK_WIDGET_OUTPUT_STATUS
    default y

config ZMK_WIDGET_LAYER_STATUS
    default y

endif

endif

if SHIELD_gojboard52_LEFT || SHIELD_gojboard52_RIGHT

config ZMK_SPLIT
    default y

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif